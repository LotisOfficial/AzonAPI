# Copy to .env (git-ignored). Placeholder values only - never commit real secrets.

# --- Docker Compose ---
# Host folder that holds one sub-folder per repository (each with .pprj/.pont/.pins).
AZON_REPOSITORIES_DIR=C:/path/to/repositories
# Repository loaded at startup, relative to that folder.
AZON_DEFAULT_REPOSITORY=Example/Example.pprj

# --- Native run (set in the start script's environment) ---
# JAVA_HOME=C:/path/to/java8
# REPO_ROOT=C:/path/to/repositories
# PPRJ_FILE=C:/path/to/repositories/Example/Example.pprj
# CONFIG_FILE=C:/path/to/azon-stack/config/active.json
# AZON_API_TOKENS_FILE=C:/path/to/azon-stack/secrets/api_tokens.json
# AZON_VIEWER_TARGETS_FILE=C:/path/to/azon-stack/secrets/viewer_targets.json

# --- Optional ---
# AZON_MAX_BODY_BYTES=1048576
# AZON_LOG_LEVEL=INFO
# AZON_API_DOCS=1        # development only: serves Swagger UI without authentication
